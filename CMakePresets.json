{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 28,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "ninja-default",
      "hidden": true,
      "generator": "Ninja",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "BUILD_TESTING": "ON",
        "DOMAINFLOW_BUILD_TESTING": "ON",
        "DOMAINFLOW_TOOLS": "ON",
        "DOMAINFLOW_DSE": "ON"
      }
    },
    {
      "name": "vs17-default",
      "hidden": true,
      "generator": "Visual Studio 17 2022"
    },
    {
      "name": "Ninja-Debug",
      "inherits": "ninja-default",
      "description": "Ninja Debug build (inherit in user presets, add CMAKE_TOOLCHAIN_FILE if using vcpkg)",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "Ninja-Release",
      "inherits": "ninja-default",
      "description": "Ninja Release build (inherit in user presets, add CMAKE_TOOLCHAIN_FILE if using vcpkg)",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "VS17-Debug",
      "inherits": "vs17-default",
      "description": "Visual Studio 17 Debug build (inherit in user presets, add CMAKE_TOOLCHAIN_FILE for vcpkg)",
      "binaryDir": "${sourceDir}/build_msvc/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "VS17-Release",
      "inherits": "vs17-default",
      "description": "Visual Studio 17 Release build (inherit in user presets, add CMAKE_TOOLCHAIN_FILE for vcpkg)",
      "binaryDir": "${sourceDir}/build_msvc/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "ninja-default",
      "hidden": true,
      "configurePreset": "ninja-default"
    },
    {
      "name": "vs17-default",
      "hidden": true,
      "configurePreset": "vs17-default"
    },
    {
      "name": "Ninja-Debug",
      "inherits": "ninja-default",
      "configurePreset": "Ninja-Debug"
    },
    {
      "name": "Ninja-Release",
      "inherits": "ninja-default",
      "configurePreset": "Ninja-Release"
    },
    {
      "name": "VS17-Debug",
      "inherits": "vs17-default",
      "configurePreset": "VS17-Debug"
    },
    {
      "name": "VS17-Release",
      "inherits": "vs17-default",
      "configurePreset": "VS17-Release"
    }
  ]
}
