---
// Starlight <Head> override. Renders the default head, then registers a small
// client script that mounts the SURE schedule animations (issue #64). The viewer
// (and three.js) are dynamically imported ONLY on pages that actually contain a
// `<div class="schedule-anim" data-src=...>`, so non-animation pages pay nothing.
import Default from '@astrojs/starlight/components/Head.astro';
---

<Default><slot /></Default>

<script>
  async function mountSchedules() {
    const anim = document.querySelector('.schedule-anim[data-src]:not([data-mounted])');
    const compare = document.querySelector('.schedule-compare[data-src-a]:not([data-mounted])');
    if (!anim && !compare) return;
    const mod = await import('./schedule-anim.js');
    if (anim) mod.mountAll();
    if (compare) mod.mountCompareAll();
  }
  async function mountRdgs() {
    if (!document.querySelector('.rdg[data-src]:not([data-mounted])')) return;
    const { mountAll } = await import('./rdg.js');
    mountAll();
  }
  function mountAllViewers() { mountSchedules(); mountRdgs(); }
  // deferred module scripts run after the DOM is parsed; re-run after Starlight's
  // client-side navigations (view transitions) too. Each importer is guarded by a
  // presence check, so a page pays only for the viewers it actually embeds.
  mountAllViewers();
  document.addEventListener('astro:page-load', mountAllViewers);
</script>
