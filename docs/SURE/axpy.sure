// Executable version of the BLAS Level-1 axpy SURE from axpy.md:
//
//   system((i,j) | 0 <= i < N, 0 <= j < 2) {
//       x(i,j) = 0;                                // the injected value is spent in-domain
//       y(i,j) = y(i,j-1) + alpha * x(i,j-1);      // stream y along +j, pick up alpha*x once
//   }
//
//   axpy  y := alpha*x + y   is a fully-parallel elementwise map: there is no
//   inter-index dependence.  To give the vector result an oriented output face
//   the DSL needs a flow axis, so the length-N vector rides the i axis and a
//   short j pipeline turns the map into a systolic cell:
//
//     - x(i) is INJECTED on the j = -1 halo (input face reads X[i]); in-domain
//       x is 0, so the scaled contribution alpha*x is added exactly once, at
//       the front cell j = 0, and never again as y drains.
//     - y streams along +j: y is seeded with the incoming vector Y[i] on the
//       j = -1 halo, accumulates alpha*x at j = 0, then passes through to the
//       terminal j = 1 face where the result R[i] = alpha*X[i] + Y[i] exits.
//
// Faces are equality-pinned in the domain's own coordinates; the outward normal
// is derived (inputs influx, tau.n < 0; outputs outflux, tau.n > 0).  The two
// input faces sit on the one-step halo j = -1; the output leaves the terminal
// j = 1 face.  (alpha is an integer DSL parameter; the derivation covers the
// real-scalar generalization.)
//
// Run it:   dfactl --sure docs/SURE/axpy.sure
//           dfactl --sure docs/SURE/axpy.sure --tau 1,-1   (ILLEGAL flux demo)

N = 4; alpha = 2;

system ((i,j) | 0 <= i < N, 0 <= j < 2) {
    x(i,j) = 0;                                    // injected value lives only on the j = -1 halo
    y(i,j) = y(i,j-1) + alpha * x(i,j-1);          // accumulate alpha*x once, then drain
}

// tensor confluences
input  X[N] ((i,j) | 0 <= i < N, j = -1) : x(i,j) = X[i];      // inject x on the front halo
input  Y[N] ((i,j) | 0 <= i < N, j = -1) : y(i,j) = Y[i];      // seed the streaming y with the incoming vector
output R[N] ((i,j) | 0 <= i < N, j = 1)  : R[i] = y(i,j);      // result leaves the terminal face

tau = [1, 1];                    // canonical legal wavefront schedule

// test-bench data:  R = alpha*X + Y = 2*{1,2,3,4} + {10,20,30,40} = {12,24,36,48}
data X = {  1,  2,  3,  4 };
data Y = { 10, 20, 30, 40 };
