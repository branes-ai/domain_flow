// Executable version of the BLAS Level-1 dot-product SURE from dot.md:
//
//   system((i,j) | 0 <= i < N, 0 <= j < 1) {
//       x(i,j) = x(i,j-1);                         // operand X enters at the j=-1 feed halo
//       y(i,j) = y(i,j-1);                         // operand Y enters at the j=-1 feed halo
//       s(i,j) = s(i-1,j) + x(i,j-1) * y(i,j-1);   // running inner product along +i
//   }
//
//   dot  s = sum_i X[i]*Y[i]  is a REDUCTION: a linear chain of multiply-adds.
//   The partial sum s accumulates along +i (s(i) = s(i-1) + X[i]*Y[i], seeded 0
//   at i = -1) and the scalar result leaves through the single terminal point
//   i = N-1 -- a codimension-1 face of the reduction axis.
//
//   The operands X, Y are indexed by the reduction coordinate i, so they cannot
//   be injected on the i-axis halo (a single point).  We add a FEED axis j: X[i]
//   and Y[i] enter on the j = -1 halo and are consumed at their multiply-add
//   cell.  Because a reduction consumes each operand exactly once (it is not
//   reused downstream, unlike matmul's A/B which propagate across the orthogonal
//   axis), the feed is one cell deep: 0 <= j < 1.  The array is a single column
//   of MAC cells fed from j = -1, accumulating along +i.
//
//   The product x(i,j-1)*y(i,j-1) is a uniform recurrence: both taps are constant
//   offsets of the current point.  Faces are equality-pinned; the outward normal
//   is derived (inputs influx, tau.n < 0; outputs outflux, tau.n > 0).
//
// Run it:   dfactl --sure docs/SURE/dot.sure
//           dfactl --sure docs/SURE/dot.sure --tau -1,1   (ILLEGAL flux demo)

N = 4;

system ((i,j) | 0 <= i < N, 0 <= j < 1) {
    x(i,j) = x(i,j-1);                             // operand X, fed from the j = -1 halo
    y(i,j) = y(i,j-1);                             // operand Y, fed from the j = -1 halo
    s(i,j) = s(i-1,j) + x(i,j-1) * y(i,j-1);       // accumulate X[i]*Y[i] along +i
}

// tensor confluences
input  X[N] ((i,j) | 0 <= i < N, j = -1) : x(i,j) = X[i];       // feed X[i] into cell i
input  Y[N] ((i,j) | 0 <= i < N, j = -1) : y(i,j) = Y[i];       // feed Y[i] into cell i
input       ((i,j) | i = -1, 0 <= j < 1) : s(i,j) = 0;          // accumulator seed (additive identity)
output S[1] ((i,j) | i = N-1, 0 <= j < 1) : S[0] = s(i,j);      // scalar result leaves the terminal cell

tau = [1, 1];                    // canonical legal wavefront schedule

// test-bench data:  s = X.Y = 1*4 + 2*3 + 3*2 + 4*1 = 20
data X = { 1, 2, 3, 4 };
data Y = { 4, 3, 2, 1 };
