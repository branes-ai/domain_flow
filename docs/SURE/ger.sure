// BLAS-2 rank-1 update (issue #32):
//
//   A(i,j) := A(i,j) + alpha * x(i) * y(j),   0 <= i < M, 0 <= j < N
//
// ger is the outer-product counterpart to gemv: a 2-D FULLY-PARALLEL update with
// NO reduction. Every output A(i,j) is independent, formed from the incoming
// A(i,j), the scalar alpha, and one element each of x and y. It is the rank-1
// building block reused by LU (the Schur update), syr, and syr2.
//
// Domain (i,j,k):  i (0..M-1), j (0..N-1), and k = a depth-2 FEED/DRAIN axis
// (0..1). As in gemv, the matrix A is indexed by both domain axes and consumed
// once, so it has no free axis to enter on — it enters (and, updated, exits) on
// the (i,j) face of the k axis. Depth 2 (not 1) gives the result a genuine exit
// face: A seeds the accumulator on the k=-1 halo, the rank-1 term is added at
// k=0, and the result drains out at k=1 (exactly axpy's/scal's inject-add-drain).
//
//   alpha(i,j,k) = 0                          alpha lives ONLY on the k=-1 halo
//   xx(i,j,k)    = xx(i,j-1,k)                x(i) broadcast along +j
//   yy(i,j,k)    = yy(i-1,j,k)                y(j) broadcast along +i
//   r(i,j,k)     = r(i,j,k-1) + alpha(i,j,k-1)*xx(i,j-1,k)*yy(i-1,j,k)
//
// r is seeded by the incoming A on k=-1 and accumulates the rank-1 term EXACTLY
// ONCE: alpha is injected only on the k=-1 halo (its interior value is 0), so the
// product contributes at k=0 and vanishes at k=1 (the drain). Every dependence is
// a constant offset — a pure SURE (uniform). The scalar alpha is projected onto a
// face and consumed as a product of recurrence variables (project-and-pipeline /
// one-shot injection, as in scal/axpy/gemv), never a literal in a recurrence body.
//
// Run it:   dfactl --sure docs/SURE/ger.sure            (free schedule)
//           dfactl --sure docs/SURE/ger.sure --tau 1,1,1

M = 2; N = 3;

system ((i,j,k) | 0 <= i < M, 0 <= j < N, 0 <= k < 2) {
    alpha(i,j,k) = 0;                                                       // alpha only on the k=-1 halo
    xx(i,j,k)    = xx(i,j-1,k);                                             // x(i) broadcast along +j
    yy(i,j,k)    = yy(i-1,j,k);                                             // y(j) broadcast along +i
    r(i,j,k)     = r(i,j,k-1) + alpha(i,j,k-1) * xx(i,j-1,k) * yy(i-1,j,k); // add alpha*x*y once, then drain
}

// tensor confluences
input  A[M][N]  ((i,j,k) | 0 <= i < M, 0 <= j < N, k = -1)  : r(i,j,k)     = A[i][j];   // A seeds r on its (i,j) face
input  Alpha[1] ((i,j,k) | 0 <= i < M, 0 <= j < N, k = -1)  : alpha(i,j,k) = Alpha[0];  // project the scalar alpha
input  X[M]     ((i,j,k) | 0 <= i < M, j = -1, 0 <= k < 2)  : xx(i,j,k)    = X[i];       // x on the j = -1 face
input  Y[N]     ((i,j,k) | i = -1, 0 <= j < N, 0 <= k < 2)  : yy(i,j,k)    = Y[j];       // y on the i = -1 face
output Aout[M][N] ((i,j,k) | 0 <= i < M, 0 <= j < N, k = 1) : Aout[i][j] = r(i,j,k);     // updated A exits on its (i,j) face

tau = [1, 1, 1];                 // canonical legal wavefront schedule

// test bench:  A + alpha*x*y^T  with A = [[1,2,3],[4,5,6]], x = [10,20], y = [1,2,3],
//   alpha = 2  ->  [[21,42,63],[44,85,126]]
data A     = { 1, 2, 3,
               4, 5, 6 };
data X     = { 10, 20 };
data Y     = { 1, 2, 3 };
data Alpha = 2;
