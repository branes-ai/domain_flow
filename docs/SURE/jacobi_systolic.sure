// Jacobi as a PURE SURE (issue #53) -- the systolic / uniform-dataflow form.
//
// stationary.sure writes Jacobi with an AFFINE gather (xs(j,N,k) reaches across rows to a
// column's solution -- an i<->j transpose), so its RDG is a SARE. This spec removes EVERY
// affine arc: all dependence vectors are constant displacements, so it maps to a regular
// spatial array with only nearest-neighbour wires. Two techniques do it:
//
//   1. PIPELINE THE STATE.  Instead of gathering x^{k-1}_j, the value is routed cell-to-cell.
//      xx(i,j,k) holds unknown j's value at row i; it is produced at the diagonal (i=j) and
//      BROADCAST to every row -- down for i>j, up for i<j -- so the reduction reads its own
//      neighbour xx(i,j,k-1), a uniform [0,0,1], not a transpose. (This is a PIECEWISE
//      variable: three equations for xx on the disjoint sub-domains i>j, i<j, i=j.)
//
//   2. SPLIT THE REDUCTION so the solve reads ADJACENT columns.  A single sum finishes at the
//      fixed column N-1, so a diagonal solve reading it is affine (varying distance N-1 .. i).
//      Splitting into accL (columns j<i) and accU (columns j>i) lets the solve at the diagonal
//      read accL(i,j-1,k) and accU(i,j+1,k) -- and because that equation lives ONLY on i=j,
//      j-1 == i-1 there, so writing it in j makes the displacement a uniform [0,+/-1,0].
//
// Domain (i,j,k): i = row/unknown, j = column, k = iteration. Output leaves on the bottom
// row i=N-1, where the down-broadcast has delivered the whole solution vector.
//
// Result: RDG kind = SURE, 0 affine arcs (verify: dfactl --sure ... --emit-rdg). Free schedule
// only in this framework (the diagonal solve + reduction fuse per row), but the dataflow is
// fully uniform -- the point for a spatial mapping. cf. gauss_seidel_systolic.sure.
//
// Run it:   dfactl --sure docs/SURE/jacobi_systolic.sure

N = 3; K = 8;

system ((i,j,k) | 0 <= i < N, 0 <= j < N, 0 <= k < K) {
    am(i,j,k)   = am(i,j,k-1);                                          // A(i,j) held across sweeps
    bb(i,j,k)   = bb(i,j-1,k);                                          // b(i) propagated along +j
    diag(i,j,k) = diag(i,j-1,k);                                        // A(i,i) propagated along +j
    accL(i,j,k | j < i) = accL(i,j-1,k) + am(i,j,k) * xx(i,j,k-1);      // lower sum, prev-sweep state
    accU(i,j,k | j > i) = accU(i,j+1,k) + am(i,j,k) * xx(i,j,k-1);      // upper sum, reduces along -j
    xx(i,j,k | i > j) = xx(i-1,j,k);                                    // broadcast the state DOWN from the diagonal
    xx(i,j,k | i < j) = xx(i+1,j,k);                                    // broadcast the state UP from the diagonal
    xx(i,j,k | i = j) = (bb(i,j,k) - accL(i,j-1,k) - accU(i,j+1,k)) / diag(i,j,k);  // solve x^k_i (adjacent, uniform reads)
}

input A[N][N] ((i,j,k) | 0 <= i < N, 0 <= j < N, k = -1)       : am(i,j,k)   = A[i][j];   // A on its (i,j) face
input B[N]    ((i,j,k) | 0 <= i < N, j = -1, 0 <= k < K)       : bb(i,j,k)   = B[i];      // b on the j = -1 face
input Diag[N] ((i,j,k) | 0 <= i < N, j = -1, 0 <= k < K)       : diag(i,j,k) = Diag[i];   // A(i,i) on the j = -1 face
input         ((i,j,k) | 0 <= i < N, j = -1, 0 <= k < K)       : accL(i,j,k) = 0;         // lower reduction seed
input         ((i,j,k) | 0 <= i < N, j = N,  0 <= k < K)       : accU(i,j,k) = 0;         // upper reduction seed (reduces -j)
input X0[N]   ((i,j,k) | 0 <= i < N, 0 <= j < N, k = -1)       : xx(i,j,k)   = X0[j];     // initial guess x^{-1}_j
output X[N]   ((i,j,k) | i = N-1, 0 <= j < N, K-1 <= k, k < K) : X[j] = xx(i,j,k);        // solution on the bottom row

// strongly diagonally dominant system, exact solution x = [1,1,1].
data A    = { 10,  1,  1,
               1, 10,  1,
               1,  1, 10 };
data B    = { 12, 12, 12 };
data Diag = { 10, 10, 10 };
data X0   = {  0,  0,  0 };
