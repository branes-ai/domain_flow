// Executable version of the canonical systolic matmul SURE from matmul.md:
//
//   system((i,j,k) | 0 <= i < M, 0 <= j < N, 0 <= k < K) {
//       a(i,j,k) = a(i,j-1,k);
//       b(i,j,k) = b(i-1,j,k);
//       c(i,j,k) = c(i,j,k-1) + a(i,j-1,k)*b(i-1,j,k);
//   }
//
// a propagates A(i,k) along +j, b propagates B(k,j) along +i, and c
// accumulates the products along +k.
//
// Data enters and leaves through oriented confluences: a face region gets its
// extent from the inequalities, its location from the equality, and its
// orientation from the domain's outward normal (inputs: influx, tau.n < 0;
// outputs: outflux, tau.n > 0).  Input faces sit on the one-step halo where
// the boundary values are read (j = -1); the output face is the terminal
// k = K-1 face of the domain.
//
// Run it:   dfactl --sure docs/SURE/matmul.sure
//           dfactl --sure docs/SURE/matmul.sure --tau 1,1,0   (ILLEGAL schedule demo)

M = 2; N = 2; K = 3;

system ((i,j,k) | 0 <= i < M, 0 <= j < N, 0 <= k < K) {
    a(i,j,k) = a(i,j-1,k);                              // propagate A along +j
    b(i,j,k) = b(i-1,j,k);                              // propagate B along +i
    c(i,j,k) = c(i,j,k-1) + a(i,j-1,k) * b(i-1,j,k);    // accumulate along +k
}

// tensor confluences
input  A[M][K] ((i,j,k) | 0 <= i < M, 0 <= k < K, j = -1)  : a(i,j,k) = A[i][k];
input  B[K][N] ((i,j,k) | 0 <= k < K, 0 <= j < N, i = -1)  : b(i,j,k) = B[k][j];
input          ((i,j,k) | 0 <= i < M, 0 <= j < N, k = -1)  : c(i,j,k) = 0;      // accumulator seed
output C[M][N] ((i,j,k) | 0 <= i < M, 0 <= j < N, k = K-1) : C[i][j] = c(i,j,k);

tau = [1, 1, 1];                // canonical legal wavefront schedule

// test-bench data:  C = A*B = { 58, 64, 139, 154 }
data A = {  1,  2,  3,
            4,  5,  6 };
data B = {  7,  8,
            9, 10,
           11, 12 };
