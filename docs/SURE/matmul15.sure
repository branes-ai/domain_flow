// Visualization-scale matmul (issue #64): the SAME canonical systolic recurrence
// as matmul.sure, but on a 15 x 15 x 15 index space so the geometric shape of the
// domain of computation and the schedule's wavefront materialize in the docs-site
// 3-D animation (a 2 x 2 x 3 lattice is too small to read).
//
// This spec is NOT numerically checked -- the operands are scalar-filled dummy
// data (the schedule emit uses only the domain + the signature, not the values).
// The verified numerics live in matmul.sure (2 x 2 x 3). Regenerate the animation
// JSON with:  npm --prefix docs-site run schedules
//
//   dfactl --sure docs/SURE/matmul15.sure --schedule linear --emit-schedule out.json

M = 15; N = 15; K = 15;

system ((i,j,k) | 0 <= i < M, 0 <= j < N, 0 <= k < K) {
    a(i,j,k) = a(i,j-1,k);                              // propagate A along +j
    b(i,j,k) = b(i-1,j,k);                              // propagate B along +i
    c(i,j,k) = c(i,j,k-1) + a(i,j-1,k) * b(i-1,j,k);    // accumulate along +k
}

input  A[M][K] ((i,j,k) | 0 <= i < M, 0 <= k < K, j = -1)  : a(i,j,k) = A[i][k];
input  B[K][N] ((i,j,k) | 0 <= k < K, 0 <= j < N, i = -1)  : b(i,j,k) = B[k][j];
input          ((i,j,k) | 0 <= i < M, 0 <= j < N, k = -1)  : c(i,j,k) = 0;
output C[M][N] ((i,j,k) | 0 <= i < M, 0 <= j < N, k = K-1) : C[i][j] = c(i,j,k);

tau = [1, 1, 1];                // canonical legal wavefront schedule

// scalar-fill dummy operands (values unused by the schedule emit)
data A = 1;
data B = 1;
