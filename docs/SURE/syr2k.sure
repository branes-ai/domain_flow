// BLAS-3 symmetric rank-2k update (issue #39):
//
//   C(i,j) := beta*C(i,j) + alpha * sum_k ( A(i,k)*B(j,k) + B(i,k)*A(j,k) )   on j <= i
//
// i.e. C := beta*C + alpha*(A B^T + B A^T), whose sum is symmetric so only the lower
// triangle is formed. syr2k is syrk with TWO operands: two fused gemm-like reductions
// over k onto the triangular output. It appears in blocked eigen/SVD trailing updates.
//
// Four operand streams feed the two-term product (cf. syrk's single super-diagonal
// feed, and syr2's two-vector rank-2 combination):
//   ai = A(i,k) along +j       aj = A(j,k) along +i (super-diagonal)
//   bi = B(i,k) along +j       bj = B(j,k) along +i (super-diagonal)
//   c(i,j,k) = c(i,j,k-1) + alpha*(ai*bj + bi*aj)
//                = ... + alpha*( A(i,k)B(j,k) + B(i,k)A(j,k) )
//
// As in syrk, the +i taps (A(j,k), B(j,k)) enter on the super-diagonal halo i-j=-1
// because the triangle's columns begin at the diagonal; the output leaves on k=K-1,
// so that feed is a clean halo. alpha is projected and folded into the reduction;
// the incoming C scaled by beta joins the completed sum in a terminal-face epilogue.
// Every dependence is a constant offset -- a pure SURE (uniform).
//
// Schedule: the super-diagonal feeds have outward normal (-1,1,0), so the canonical
// tau = [2,1,1] (tau_i > tau_j) is legal and the box default tau = [1,1,1] is
// rejected -- as in syrk.
//
// Run it:   dfactl --sure docs/SURE/syr2k.sure           (free schedule)
//           dfactl --sure docs/SURE/syr2k.sure --tau 2,1,1

N = 3; K = 2;

system ((i,j,k) | 0 <= i < N, 0 <= j < N, j <= i, 0 <= k < K) {
    ai(i,j,k)    = ai(i,j-1,k);                                             // A(i,k) along +j
    bi(i,j,k)    = bi(i,j-1,k);                                             // B(i,k) along +j
    aj(i,j,k)    = aj(i-1,j,k);                                             // A(j,k) along +i (super-diagonal)
    bj(i,j,k)    = bj(i-1,j,k);                                             // B(j,k) along +i (super-diagonal)
    alpha(i,j,k) = alpha(i,j,k-1);                                          // scalar alpha along +k
    beta(i,j,k)  = beta(i,j,k-1);                                           // scalar beta along +k
    cin(i,j,k)   = cin(i,j,k-1);                                            // incoming C along +k
    c(i,j,k)     = c(i,j,k-1) + alpha(i,j,k-1) * (ai(i,j-1,k)*bj(i-1,j,k) + bi(i,j-1,k)*aj(i-1,j,k));
}

// tensor confluences — two operands, each feeding a +j tap and a super-diagonal +i tap:
input  A[N][K]   ((i,j,k) | 0 <= i < N, 0 <= k < K, j = -1)                  : ai(i,j,k)    = A[i][k];  // A(i,k)
input  B[N][K]   ((i,j,k) | 0 <= i < N, 0 <= k < K, j = -1)                  : bi(i,j,k)    = B[i][k];  // B(i,k)
input            ((i,j,k) | -1 <= i < N, 0 <= j < N, i - j = -1, 0 <= k < K) : aj(i,j,k)    = A[j][k];  // A(j,k) super-diag
input            ((i,j,k) | -1 <= i < N, 0 <= j < N, i - j = -1, 0 <= k < K) : bj(i,j,k)    = B[j][k];  // B(j,k) super-diag
input  Alpha[1]  ((i,j,k) | 0 <= i < N, 0 <= j < N, j <= i, k = -1)          : alpha(i,j,k) = Alpha[0];
input  Beta[1]   ((i,j,k) | 0 <= i < N, 0 <= j < N, j <= i, k = -1)          : beta(i,j,k)  = Beta[0];
input  Cin[N][N] ((i,j,k) | 0 <= i < N, 0 <= j < N, j <= i, k = -1)          : cin(i,j,k)   = Cin[i][j];
input            ((i,j,k) | 0 <= i < N, 0 <= j < N, j <= i, k = -1)          : c(i,j,k)     = 0;
output C[N][N]   ((i,j,k) | 0 <= i < N, 0 <= j < N, j <= i, k = K-1)         : C[i][j] = c(i,j,k) + beta(i,j,k)*cin(i,j,k);

tau = [2, 1, 1];                 // canonical schedule (tau_i > tau_j for the super-diagonal influx)

// test bench:  C = beta*Cin + alpha*(A B^T + B A^T) (lower)
//   A = [[1,2],[3,4],[5,6]], B = [[1,0],[0,1],[1,1]]
//   A B^T + B A^T (lower) = [[2],[5,8],[8,13,22]];  alpha=2, beta=10, Cin lower [[1],[2,3],[4,5,6]]
//   -> C = [[14],[30,46],[56,76,104]]
data A     = { 1, 2,   3, 4,   5, 6 };
data B     = { 1, 0,   0, 1,   1, 1 };
data Cin   = { 1, 0, 0,
               2, 3, 0,
               4, 5, 6 };
data Alpha = 2;
data Beta  = 10;
